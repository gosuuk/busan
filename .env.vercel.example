# Required in Vercel Preview and Production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace_with_32_plus_character_secret
BETTER_AUTH_URL=https://your-vercel-domain.vercel.app
MEMBER_JWT_SECRET=replace_with_32_plus_character_member_jwt_secret
ADMIN_JWT_SECRET=replace_with_32_plus_character_admin_jwt_secret
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app

# Required when running the production admin seed command.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_12_plus_character_password_123
ADMIN_SEED_NAME=관리자
ADMIN_SEED_PHONE=01099990000

# Optional but recommended.
CRON_SECRET=replace_with_32_plus_character_cron_secret
ANALYTICS_HASH_SECRET=replace_with_32_plus_character_analytics_secret

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional integrations.
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
